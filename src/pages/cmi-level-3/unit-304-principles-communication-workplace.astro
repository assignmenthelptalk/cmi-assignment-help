---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-304');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-304');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 304 Assignment Help — Principles of Communication in the Workplace',
    description: 'Expert CMI Unit 304 assignment help. UK writers cover communication models, barriers to communication, and adapting style for different audiences. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 304 Assignment Help — Principles of Communication in the Workplace"
  description="Expert CMI Unit 304 assignment help. UK writers cover communication models, barriers to communication, and adapting style for different audiences. WhatsApp for a free quote."
  slug="/cmi-level-3/unit-304-principles-communication-workplace/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 304 Assignment Help', href: '/cmi-level-3/unit-304-principles-communication-workplace/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
