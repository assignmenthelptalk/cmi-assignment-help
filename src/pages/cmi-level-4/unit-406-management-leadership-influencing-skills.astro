---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-4-unit-406');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-4-unit-406');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 406 Assignment Help — Management and Leadership Influencing Skills',
    description: 'Expert CMI Unit 406 assignment help. UK writers cover influence, persuasion, negotiation, and leadership influence models applied to a management context. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 406 Assignment Help — Management and Leadership Influencing Skills"
  description="Expert CMI Unit 406 assignment help. UK writers cover influence, persuasion, negotiation, and leadership influence models applied to a management context. WhatsApp for a free quote."
  slug="/cmi-level-4/unit-406-management-leadership-influencing-skills/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 4 Assignment Help', href: '/cmi-level-4-assignment-help/' },
    { label: 'CMI 406 Assignment Help', href: '/cmi-level-4/unit-406-management-leadership-influencing-skills/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
