---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-611');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-611');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 611 Assignment Help — Strategic Knowledge Management',
    description: 'Expert CMI Unit 611 assignment help. Senior UK writers cover knowledge management frameworks, intellectual capital, and organisational learning systems. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 611 Assignment Help — Strategic Knowledge Management"
  description="Expert CMI Unit 611 assignment help. Senior UK writers cover knowledge management frameworks, intellectual capital, and organisational learning systems. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-611-strategic-knowledge-management/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 611 Assignment Help', href: '/cmi-level-6/unit-611-strategic-knowledge-management/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
