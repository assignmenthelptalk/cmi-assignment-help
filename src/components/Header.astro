      { label: '306 · Coaching and Mentoring', href: '/cmi-level-3/unit-306-principles-coaching-mentoring/' },
      { label: '307 · Developing Knowledge and Skills', href: '/cmi-level-3/unit-307-developing-knowledge-skills-abilities/' },
      { label: '308 · Understanding Innovation and Change', href: '/cmi-level-3/unit-308-understanding-innovation-change/' },
