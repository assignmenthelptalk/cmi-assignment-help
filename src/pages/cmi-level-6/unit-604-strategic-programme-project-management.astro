---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-604');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-604');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 604 Assignment Help — Strategic Programme and Project Management',
    description: 'Expert CMI Unit 604 assignment help. Senior UK writers cover programme governance, benefits realisation, and leading complex multi-stakeholder programmes. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 604 Assignment Help — Strategic Programme and Project Management"
  description="Expert CMI Unit 604 assignment help. Senior UK writers cover programme governance, benefits realisation, and leading complex multi-stakeholder programmes. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-604-strategic-programme-project-management/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 604 Assignment Help', href: '/cmi-level-6/unit-604-strategic-programme-project-management/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
