---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-308');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-308');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 308 Assignment Help — Understanding Innovation and Change',
    description: 'Expert CMI Unit 308 assignment help. UK writers cover Lewin\'s change model, drivers of change, and managing resistance in a team. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 308 Assignment Help — Understanding Innovation and Change"
  description="Expert CMI Unit 308 assignment help. UK writers cover Lewin's change model, drivers of change, and managing resistance in a team. WhatsApp for a free quote."
  slug="/cmi-level-3/unit-308-understanding-innovation-change/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 308 Assignment Help', href: '/cmi-level-3/unit-308-understanding-innovation-change/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
