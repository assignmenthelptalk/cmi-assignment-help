---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-609');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-609');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 609 Assignment Help — Leading Equality, Diversity and Inclusion',
    description: 'Expert CMI Unit 609 assignment help. Senior UK writers cover strategic EDI leadership, systemic inclusion, and Critically Evaluate EDI evidence at senior level. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 609 Assignment Help — Leading Equality, Diversity and Inclusion"
  description="Expert CMI Unit 609 assignment help. Senior UK writers cover strategic EDI leadership, systemic inclusion, and Critically Evaluate EDI evidence at senior level. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-609-leading-equality-diversity-inclusion/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 609 Assignment Help', href: '/cmi-level-6/unit-609-leading-equality-diversity-inclusion/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
