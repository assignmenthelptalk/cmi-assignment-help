---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-assignment-examples');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-assignment-examples');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'CMI Level 3 Assignment Examples: Annotated Structure of an Essay',
    description: 'Annotated guide to a CMI Level 3 assignment: essay structure, word budget, Identify, Describe and Explain depth, and what lifts a response to Merit.',
    author: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    publisher: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI Level 3 Assignment Examples | CMI Assignment Support"
  description="Annotated guide to a CMI Level 3 assignment: essay structure, word budget, Identify, Describe and Explain depth, and what lifts a response to Merit."
  slug="/cmi-level-3-assignment-examples/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Assignment Examples', href: '/cmi-assignment-examples/' },
    { label: 'CMI Level 3 Assignment Examples', href: '/cmi-level-3-assignment-examples/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>