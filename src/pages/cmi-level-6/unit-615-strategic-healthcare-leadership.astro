---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-615');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-615');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 615 Assignment Help — Strategic Healthcare Leadership',
    description: 'Expert CMI Unit 615 assignment help. Senior UK writers cover NHS leadership frameworks, patient safety culture, and strategic planning in healthcare. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 615 Assignment Help — Strategic Healthcare Leadership"
  description="Expert CMI Unit 615 assignment help. Senior UK writers cover NHS leadership frameworks, patient safety culture, and strategic planning in healthcare. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-615-strategic-healthcare-leadership/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 615 Assignment Help', href: '/cmi-level-6/unit-615-strategic-healthcare-leadership/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
