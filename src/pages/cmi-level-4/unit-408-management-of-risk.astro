---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-4-unit-408');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-4-unit-408');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 408 Assignment Help — Management of Risk',
    description: 'Expert CMI Unit 408 assignment help. UK writers cover risk identification, likelihood-impact assessment, mitigation strategies, and the manager\'s risk responsibilities. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 408 Assignment Help — Management of Risk"
  description="Expert CMI Unit 408 assignment help. UK writers cover risk identification, likelihood-impact assessment, mitigation strategies, and the manager's risk responsibilities. WhatsApp for a free quote."
  slug="/cmi-level-4/unit-408-management-of-risk/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 4 Assignment Help', href: '/cmi-level-4-assignment-help/' },
    { label: 'CMI 408 Assignment Help', href: '/cmi-level-4/unit-408-management-of-risk/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
