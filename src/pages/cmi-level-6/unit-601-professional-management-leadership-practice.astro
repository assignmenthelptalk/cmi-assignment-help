---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-601');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-601');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 601 Assignment Help — Professional Management and Leadership Practice',
    description: 'Expert CMI Unit 601 assignment help. Senior UK writers cover professional management philosophy, ethical leadership, and Critically Evaluate at Level 6 depth. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 601 Assignment Help — Professional Management and Leadership Practice"
  description="Expert CMI Unit 601 assignment help. Senior UK writers cover professional management philosophy, ethical leadership, and Critically Evaluate at Level 6 depth. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-601-professional-management-leadership-practice/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 601 Assignment Help', href: '/cmi-level-6/unit-601-professional-management-leadership-practice/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
