---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-4-unit-407');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-4-unit-407');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 407 Assignment Help — Managing Data and Information',
    description: 'Expert CMI Unit 407 assignment help. UK writers cover data governance, information quality, GDPR responsibilities, and data-driven management decision-making. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 407 Assignment Help — Managing Data and Information"
  description="Expert CMI Unit 407 assignment help. UK writers cover data governance, information quality, GDPR responsibilities, and data-driven management decision-making. WhatsApp for a free quote."
  slug="/cmi-level-4/unit-407-managing-data-information/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 4 Assignment Help', href: '/cmi-level-4-assignment-help/' },
    { label: 'CMI 407 Assignment Help', href: '/cmi-level-4/unit-407-managing-data-information/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
