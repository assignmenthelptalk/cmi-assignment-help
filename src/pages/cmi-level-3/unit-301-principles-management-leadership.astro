---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-301');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-301');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 301 Assignment Help — Principles of Management and Leadership',
    description: 'Expert CMI Unit 301 assignment help for First Line Management. UK writers cover management vs leadership distinction, styles, and responsibilities. Free quote on WhatsApp.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 301 Assignment Help — Principles of Management and Leadership"
  description="Expert CMI Unit 301 assignment help for First Line Management. UK writers cover management vs leadership distinction, styles, and responsibilities. Free quote on WhatsApp."
  slug="/cmi-level-3/unit-301-principles-management-leadership/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 301 Assignment Help', href: '/cmi-level-3/unit-301-principles-management-leadership/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
