---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-302');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-302');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 302 Assignment Help — Managing a Team to Achieve Results',
    description: 'Expert CMI Unit 302 assignment help. UK writers cover team roles, Belbin, performance expectations, and communication in a team. Free quote on WhatsApp.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 302 Assignment Help — Managing a Team to Achieve Results"
  description="Expert CMI Unit 302 assignment help. UK writers cover team roles, Belbin, performance expectations, and communication in a team. Free quote on WhatsApp."
  slug="/cmi-level-3/unit-302-managing-team-achieve-results/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 302 Assignment Help', href: '/cmi-level-3/unit-302-managing-team-achieve-results/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
