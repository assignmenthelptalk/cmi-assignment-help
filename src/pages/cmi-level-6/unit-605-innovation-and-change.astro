---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-605');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-605');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 605 Assignment Help — Innovation and Change',
    description: 'Expert CMI Unit 605 assignment help. Senior UK writers cover disruptive innovation strategy, transformational change leadership, and Critically Evaluate at Level 6. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 605 Assignment Help — Innovation and Change"
  description="Expert CMI Unit 605 assignment help. Senior UK writers cover disruptive innovation strategy, transformational change leadership, and Critically Evaluate at Level 6. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-605-innovation-and-change/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 605 Assignment Help', href: '/cmi-level-6/unit-605-innovation-and-change/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
