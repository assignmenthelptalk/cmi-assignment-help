---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-6-unit-614');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-6-unit-614');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 614 Assignment Help — Personal and Professional Development',
    description: 'Expert CMI Unit 614 assignment help. Senior UK writers cover reflective leadership practice, CPD at senior level, and personal development planning. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 614 Assignment Help — Personal and Professional Development"
  description="Expert CMI Unit 614 assignment help. Senior UK writers cover reflective leadership practice, CPD at senior level, and personal development planning. WhatsApp for a free quote."
  slug="/cmi-level-6/unit-614-personal-professional-development/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 6 Assignment Help', href: '/cmi-level-6-assignment-help/' },
    { label: 'CMI 614 Assignment Help', href: '/cmi-level-6/unit-614-personal-professional-development/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
