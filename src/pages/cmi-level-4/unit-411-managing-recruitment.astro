---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-4-unit-411');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-4-unit-411');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 411 Assignment Help — Managing Recruitment',
    description: 'Expert CMI Unit 411 assignment help. UK writers cover workforce planning, job design, selection methods, equality in recruitment, and induction planning. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://www.cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 411 Assignment Help — Managing Recruitment"
  description="Expert CMI Unit 411 assignment help. UK writers cover workforce planning, job design, selection methods, equality in recruitment, and induction planning. WhatsApp for a free quote."
  slug="/cmi-level-4/unit-411-managing-recruitment/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 4 Assignment Help', href: '/cmi-level-4-assignment-help/' },
    { label: 'CMI 411 Assignment Help', href: '/cmi-level-4/unit-411-managing-recruitment/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
