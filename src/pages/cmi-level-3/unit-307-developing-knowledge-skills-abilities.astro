---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-307');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-307');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 307 Assignment Help — Developing Knowledge, Skills and Abilities',
    description: 'Expert CMI Unit 307 assignment help. UK writers cover training needs analysis, CPD, Kolb\'s learning cycle, and Honey and Mumford learning styles. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 307 Assignment Help — Developing Knowledge, Skills and Abilities"
  description="Expert CMI Unit 307 assignment help. UK writers cover training needs analysis, CPD, Kolb's learning cycle, and Honey and Mumford learning styles. WhatsApp for a free quote."
  slug="/cmi-level-3/unit-307-developing-knowledge-skills-abilities/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 307 Assignment Help', href: '/cmi-level-3/unit-307-developing-knowledge-skills-abilities/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
