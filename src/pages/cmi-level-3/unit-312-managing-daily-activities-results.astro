---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { extractFaqs, buildFaqSchema } from '../../utils/faq';

const entry = await getEntry('pages', 'cmi-level-3-unit-312');
const { Content } = await render(entry);
const faqs = extractFaqs('cmi-level-3-unit-312');

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'CMI 312 Assignment Help — Managing Daily Activities to Achieve Results',
    description: 'Expert CMI Unit 312 assignment help. UK writers cover workload prioritisation, time management, resource allocation, and operational planning. WhatsApp for a free quote.',
    provider: {
      '@type': 'Organization',
      name: 'CMI Assignment Support',
      url: 'https://cmiassignmentsupport.co.uk',
    },
    areaServed: 'GB',
    serviceType: 'CMI assignment writing support',
  },
  buildFaqSchema(faqs),
];
---
<BaseLayout
  title="CMI 312 Assignment Help — Managing Daily Activities to Achieve Results"
  description="Expert CMI Unit 312 assignment help. UK writers cover workload prioritisation, time management, resource allocation, and operational planning. WhatsApp for a free quote."
  slug="/cmi-level-3/unit-312-managing-daily-activities-results/"
  schemas={schemas}
  breadcrumb={[
    { label: 'CMI Level 3 Assignment Help', href: '/cmi-level-3-assignment-help/' },
    { label: 'CMI 312 Assignment Help', href: '/cmi-level-3/unit-312-managing-daily-activities-results/' },
  ]}
>
  <article class="prose-page--wide">
    <Content />
  </article>
</BaseLayout>
